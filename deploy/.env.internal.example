# 镜像名
IDM_APP_IMAGE=corp-idm-platform:internal
IDM_WEB_IMAGE=corp-idm-web:internal
MYSQL_IMAGE=mysql:8.0
OPENLDAP_IMAGE=osixia/openldap:1.5.0

# 暴露端口
APP_EXPOSE_PORT=8081
WEB_EXPOSE_PORT=80
MYSQL_EXPOSE_PORT=3307
LDAP_EXPOSE_PORT=389

# Spring profile
SPRING_PROFILES_ACTIVE=prod

# 导入文件目录（宿主机）
IMPORTS_HOST_DIR=./imports

# 数据库容器
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=corp_idm
MYSQL_USER=corp_idm
MYSQL_PASSWORD=corp_idm
TZ=Asia/Shanghai

# 应用数据库连接
APP_DB_URL=jdbc:mysql://mysql:3306/corp_idm?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
APP_DB_USERNAME=corp_idm
APP_DB_PASSWORD=corp_idm
APP_DB_MAX_POOL_SIZE=30
APP_DB_MIN_IDLE=8
APP_DB_CONNECTION_TIMEOUT_MS=30000
APP_DB_VALIDATION_TIMEOUT_MS=5000

# LDAP 容器
LDAP_ORGANISATION=corp
LDAP_DOMAIN=corp.local
LDAP_ADMIN_PASSWORD=admin

# 应用 LDAP 连接
APP_LDAP_URL=ldap://openldap:389
APP_LDAP_BIND_DN=cn=admin,dc=corp,dc=local
APP_LDAP_BIND_PASSWORD=admin
APP_LDAP_BASE_DN=dc=corp,dc=local
APP_LDAP_PEOPLE_OU=ou=people
APP_LDAP_GROUPS_OU=ou=groups
APP_LDAP_MODE=spring

# 启动校验
APP_STARTUP_CHECK_ENABLED=true
APP_STARTUP_CHECK_VERIFY_PLACEHOLDER_USER=false
APP_STARTUP_CHECK_PLACEHOLDER_UID=placeholder

# JWT
APP_JWT_SECRET=replace-with-your-jwt-secret
APP_JWT_EXPIRE_MINUTES=30

# 邮件配置加密主密钥（16/24/32 字节）
APP_MAIL_SECURITY_SECRET_KEY=replace-with-32-byte-secret-key

# 固定 SMTP 回退配置（如不使用可留空）
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=
SPRING_MAIL_PROPERTIES_MAIL_SMTP_SSL_ENABLE=
APP_PASSWORD_RESET_MAIL_FROM=

# 飞书在线同步（内网无公网时建议关闭）
APP_SYNC_FEISHU_ENABLED=false
APP_SYNC_FEISHU_BASE_URL=https://open.feishu.cn
APP_SYNC_FEISHU_APP_ID=
APP_SYNC_FEISHU_APP_SECRET=
APP_SYNC_FEISHU_PAGE_SIZE=50
APP_SYNC_FEISHU_CONNECT_TIMEOUT_MS=5000
APP_SYNC_FEISHU_READ_TIMEOUT_MS=10000

# 飞书文件导入
APP_SYNC_FEISHU_FILE_IMPORT_ENABLED=true
APP_SYNC_FEISHU_FILE_IMPORT_ROOT_DIR=/app/imports
APP_SYNC_FEISHU_FILE_IMPORT_MAX_SIZE=2097152
